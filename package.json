{
  "name": "rajvya-jewellers",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "python scripts/migrate.py",
    "db:seed": "python scripts/seed.py",
    "eval": "tsx scripts/evaluate.ts",
    "mcp": "tsx scripts/mcp.ts",
    "lint": "eslint .",
    "format": "prettier --write src scripts tests *.ts *.mjs *.json .github/workflows/*.yml",
    "format:check": "prettier --check src scripts tests *.ts *.mjs *.json .github/workflows/*.yml",
    "check:env": "tsx scripts/check-env.ts",
    "predev": "npm run check:env",
    "prestart": "npm run check:env"
  },
  "dependencies": {
    "@google/genai": "^1.37.0",
    "@langchain/core": "^1.1.0",
    "@langchain/langgraph": "^1.1.0",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.90.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.562.0",
    "next": "^16.1.0",
    "pg": "^8.16.3",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "node": "^22.23.4",
    "prettier": "^3.9.10",
    "supabase": "^2.122.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "type": "module"
}
